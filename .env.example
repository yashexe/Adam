# outreach_agent configuration.
# Copy to .env (gitignored) and fill in. Nothing here is required to run
# QUALIFY — stage 2 needs no credentials at all.

# Stage 4, email verification. Free tier is 50 credits/month, one credit
# per address verified. Create a key at https://hunter.io/api-keys
# Without it, stage 4 degrades to the "unverified" label rather than failing.
HUNTER_API_KEY=

# Gmail credentials for stage 6 (drafts) are read from
# job_search_automation/.env, not duplicated here.

# harvest/from_paraform_pipeline/ scripts only (not part of the pipeline
# proper). Raw Cookie header from a logged-in paraform.com session; expires
# with the session. Wrap in single quotes — the value has spaces/semicolons
# and some of these scripts are shell, not just Python.
PARAFORM_COOKIE=''
