<?xml version="1.0" encoding="UTF-8"?>
<!--
  The unattended trigger: every five minutes, bin/tick.py asks the Pi for
  new postings and, when enough have waited, launches one bounded headless
  outreach run (docs/decisions.md, 2026-09-03). Drafts land in Gmail;
  nothing sends. The Mac has to be awake; launchd runs missed intervals
  on wake.

  Timing is deliberate: the Pi's poll writes tracker.db from :00 to about
  :01:20 of every five-minute slot, and a read from here holds a shared
  lock the poll's commit cannot wait out (it crashed twice on 2026-09-03).
  So the tick is pinned to :02 of each slot by calendar rather than a
  drifting 300-second interval, and tick.py sleeps a further 30 seconds,
  landing the read at :02:30 -- the poll long finished, the next one
  two and a half minutes away.

  Install (deliberately by hand, like the UI agent):
      cp com.yash.adam-tick.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.yash.adam-tick.plist

  Stop / uninstall:
      launchctl unload ~/Library/LaunchAgents/com.yash.adam-tick.plist

  Watch it:
      tail -f .cache/unattended/tick.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yash.adam-tick</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/yashbhavsar/Code/Adam/bin/tick.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yashbhavsar/Code/Adam</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>2</integer></dict>
        <dict><key>Minute</key><integer>7</integer></dict>
        <dict><key>Minute</key><integer>12</integer></dict>
        <dict><key>Minute</key><integer>17</integer></dict>
        <dict><key>Minute</key><integer>22</integer></dict>
        <dict><key>Minute</key><integer>27</integer></dict>
        <dict><key>Minute</key><integer>32</integer></dict>
        <dict><key>Minute</key><integer>37</integer></dict>
        <dict><key>Minute</key><integer>42</integer></dict>
        <dict><key>Minute</key><integer>47</integer></dict>
        <dict><key>Minute</key><integer>52</integer></dict>
        <dict><key>Minute</key><integer>57</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- The claude binary and ssh need the user's PATH, not launchd's. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/yashbhavsar/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- launchd schedules to the minute; this lands the read at :02:30. -->
        <key>ADAM_TICK_DELAY_SECONDS</key>
        <string>30</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/yashbhavsar/Code/Adam/.cache/unattended/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yashbhavsar/Code/Adam/.cache/unattended/launchd.log</string>
</dict>
</plist>
